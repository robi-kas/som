# ── Pick ONE of the two setups ─────────────────────────────────────────────
#
# A) Cafe laptop / PC, no website domain (phones use the local Wi-Fi or hotspot):
#      DOMAIN=:80
#      COOKIE_SECURE=false
#      PRINT_MODE=direct
#    Staff open  http://<this computer's IP>  (no :3000). Plain http: fine on your own
#    network, but use a password-protected Wi-Fi and don't let customers join it.
#
# B) Server with a domain (DNS A record pointing at it). Caddy gets HTTPS automatically:
#      DOMAIN=pos.example.com
#      COOKIE_SECURE=true
#      PRINT_MODE=agent      (run apps/print-agent on a PC inside the cafe)
DOMAIN=:80
COOKIE_SECURE=false
PRINT_MODE=direct

POSTGRES_USER=cafe
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=cafe

# Encrypts nightly backups. Store it somewhere other than this computer (a password manager).
BACKUP_PASSPHRASE=change-me-long-random
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
