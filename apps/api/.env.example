# Local development (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://cafe:cafe_password@localhost:5433/cafe_db?schema=public"
PORT=3001

# Sessions
SESSION_TTL_HOURS=16          # longest a login lasts (one long shift)
SESSION_IDLE_MINUTES=240      # automatic logout after this much inactivity
COOKIE_SECURE=false           # true in production (HTTPS)

# Printing: "agent" (print agent in the cafe) or "direct" (API prints to printer IPs itself)
PRINT_MODE=direct
PRINTER_COLUMNS=48            # 48 for 80mm paper, 32 for 58mm

# Business clock (Ethiopia is UTC+3, no daylight saving)
BUSINESS_TIMEZONE=Africa/Addis_Ababa
BUSINESS_UTC_OFFSET_HOURS=3

# Rate limit per client IP per minute (every device in a cafe usually shares one IP)
THROTTLE_LIMIT=2000

# Optional
# CORS_ORIGINS=https://admin.example.com
# LOG_FORMAT=json
# SEED_ADMIN_PASSWORD=...     # required when seeding a production database

# "Reset data" in Settings → Danger zone (owner only). On by default in development;
# OFF in production unless set to true. Turn it on only for the minutes you need it.
# ALLOW_DATA_RESET=true
