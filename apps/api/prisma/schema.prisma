generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  logoReference     String?             // shown on every screen and printed on bills
  createdAt         DateTime            @default(now())
  branches          Branch[]
  Category          Category[]
  kitchenStations   KitchenStation[]
  KitchenTicket     KitchenTicket[]
  Order             Order[]
  OrderItem         OrderItem[]
  OrderItemModifier OrderItemModifier[]
  products          Product[]
  Refund            Refund[]
  roles             Role[]
  tables            Table[]
  users             User[]
  VoidRecord        VoidRecord[]
}

model Branch {
  id                String               @id @default(uuid())
  organizationId    String
  name              String
  currency          String               @default("ETB")
  taxMode           String               @default("EXCLUSIVE")
  createdAt         DateTime             @default(now())
  organization      Organization         @relation(fields: [organizationId], references: [id])
  config            BranchConfiguration?
  shifts            CashierShift[]
  categories        Category[]
  devices           Device[]
  kitchenStations   KitchenStation[]
  KitchenTicket     KitchenTicket[]
  Order             Order[]
  OrderItem         OrderItem[]
  OrderItemModifier OrderItemModifier[]
  Product           Product[]
  Refund            Refund[]
  tables            Table[]
  userBranches      UserBranch[]
  VoidRecord        VoidRecord[]
  printers          Printer[]
  printAgents       PrintAgent[]
  paymentMethods    PaymentMethod[]
}

model User {
  id                      String                   @id @default(uuid())
  username                String
  passwordHash            String
  isActive                Boolean                  @default(true)
  organizationId          String
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  passwordChangedAt       DateTime?
  forcePasswordChange     Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  pinHash                 String?
  pinFailedCount          Int                      @default(0)
  pinLockedUntil          DateTime?
  approvalsGranted        ApprovalGrant[]          @relation("ApprovalGrantApprover")
  stations                UserStation[]
  auditLogs               AuditLog[]
  cashMovements           CashMovement[]
  employee                Employee?
  ordersHandled           Order[]                  @relation("OrderWaiter")
  itemStatusChanges       OrderItemStatusHistory[]
  paymentsReceived        Payment[]                @relation("PaymentReceivedBy")
  paymentsVerified        Payment[]                @relation("PaymentVerifiedBy")
  refundsApproved         Refund[]                 @relation("RefundApprovedBy")
  refundsInitiated        Refund[]                 @relation("RefundInitiatedBy")
  sessions                Session[]
  reconciliationsApproved ShiftReconciliation[]    @relation("ShiftReconciliationApprovedBy")
  organization            Organization             @relation(fields: [organizationId], references: [id])
  userBranches            UserBranch[]
  userRoles               UserRole[]
  voidRecords             VoidRecord[]

  @@unique([organizationId, username])
}

model Role {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserBranch {
  id       String @id @default(uuid())
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, branchId])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  deviceId       String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])
}

model Device {
  id               String @id @default(uuid())
  branchId         String
  name             String
  deviceIdentifier String @unique
  branch           Branch @relation(fields: [branchId], references: [id])
}

model Employee {
  id        String @id @default(uuid())
  userId    String @unique
  firstName String
  lastName  String
  role      String
  user      User   @relation(fields: [userId], references: [id])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  displayOrder   Int          @default(0)
  isActive       Boolean      @default(true)
  branch         Branch       @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([branchId, name])
}

model Product {
  id                   String          @id @default(uuid())
  organizationId       String
  branchId             String
  categoryId           String
  name                 String
  description          String?
  sellingPrice         Decimal         @db.Decimal(18, 2)
  status               String          @default("AVAILABLE")
  preparationStationId String?
  imageReference       String?
  isActive             Boolean         @default(true)
  version              Int             @default(1)
  branch               Branch          @relation(fields: [branchId], references: [id])
  category             Category        @relation(fields: [categoryId], references: [id])
  organization         Organization    @relation(fields: [organizationId], references: [id])
  station              KitchenStation? @relation(fields: [preparationStationId], references: [id])
  modifiers            ProductModifier[]
}

/// An add-on the waiter can pick for a product ("Extra shot", "No onions").
/// Prices live here, on the server; the client only ever sends the modifier id.
model ProductModifier {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  name           String
  priceDelta     Decimal  @default(0) @db.Decimal(18, 2)
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Table {
  id             String       @id @default(uuid())
  branchId       String
  organizationId String
  name           String
  displayOrder   Int          @default(0)
  isActive       Boolean      @default(true)
  capacity       Int
  status         String       @default("AVAILABLE")
  version        Int          @default(1)
  orders         Order[]
  branch         Branch       @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([branchId, name])
}

model Order {
  id                          String          @id @default(uuid())
  orderNumber                 String
  organizationId              String
  branchId                    String
  tableId                     String?
  deviceId                    String?
  waiterId                    String?
  type                        String          @default("DINE_IN")
  status                      String          @default("DRAFT")
  paymentStatus               String          @default("UNPAID")
  subtotal                    Decimal         @default(0) @db.Decimal(18, 2)
  discountAmount              Decimal         @default(0) @db.Decimal(18, 2)
  serviceChargeAmount         Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount                   Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount                 Decimal         @default(0) @db.Decimal(18, 2)
  taxConfigSnapshot           Json?
  serviceChargeConfigSnapshot Json?
  roundingModeSnapshot        String?
  version                     Int             @default(1)
  fireBatchNumber             Int             @default(0)
  discountType                String?
  discountValue               Decimal?        @db.Decimal(18, 2)
  discountReason              String?
  discountAppliedById         String?
  discountApprovedById        String?
  closedAt                    DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  currency                    String          @db.Char(3)
  tickets                     KitchenTicket[]
  branch                      Branch          @relation(fields: [branchId], references: [id])
  organization                Organization    @relation(fields: [organizationId], references: [id])
  table                       Table?          @relation(fields: [tableId], references: [id])
  waiter                      User?           @relation("OrderWaiter", fields: [waiterId], references: [id])
  items                       OrderItem[]
  payments                    Payment[]
  refunds                     Refund[]
  VoidRecord                  VoidRecord[]

  @@unique([branchId, orderNumber])
}

model OrderItem {
  id                  String                   @id @default(uuid())
  organizationId      String
  branchId            String
  orderId             String
  kitchenTicketId     String?
  stationId           String?
  productId           String
  quantity            Int
  notes               String?
  status              String                   @default("PENDING")
  version             Int                      @default(1)
  productNameSnapshot String
  unitPriceSnapshot   Decimal                  @db.Decimal(18, 2)
  branch              Branch                   @relation(fields: [branchId], references: [id])
  ticket              KitchenTicket?           @relation(fields: [kitchenTicketId], references: [id])
  order               Order                    @relation(fields: [orderId], references: [id])
  organization        Organization             @relation(fields: [organizationId], references: [id])
  station             KitchenStation?          @relation(fields: [stationId], references: [id])
  modifiers           OrderItemModifier[]
  statusHistory       OrderItemStatusHistory[]
  refundItems         RefundItem[]
}

model Payment {
  id                  String           @id @default(uuid())
  orderId             String
  method              String
  currency            String           @db.Char(3)
  tenderedAmount      Decimal          @db.Decimal(18, 2)
  appliedAmount       Decimal          @db.Decimal(18, 2)
  changeAmount        Decimal          @default(0) @db.Decimal(18, 2)
  status              String
  receivedById        String
  verifiedById        String?
  referenceNumber     String?
  externalProviderRef String?
  createdAt           DateTime         @default(now())
  confirmedAt         DateTime?
  version             Int              @default(1)
  evidenceId          String?
  organizationId      String
  refundableAmount    Decimal          @default(0) @db.Decimal(18, 2)
  rejectedReason      String?
  methodName          String?          // name at the time of payment ("Telebirr"), so renames don't rewrite history
  payerBank           String?          // for "Other bank / app": which bank the customer paid from
  reportedByWaiter    Boolean          @default(false) // recorded on a waiter's phone, not at the till
  evidence            PaymentEvidence? @relation(fields: [evidenceId], references: [id])
  order               Order            @relation(fields: [orderId], references: [id])
  receivedBy          User             @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  verifiedBy          User?            @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  refunds             Refund[]

  @@index([orderId, status])
}

model Refund {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  orderId        String
  paymentId      String
  amount         Decimal      @db.Decimal(18, 2)
  method         String       @db.VarChar(32)
  status         String       @db.VarChar(32)
  reason         String
  initiatedById  String
  approvedById   String?
  createdAt      DateTime     @default(now())
  confirmedAt    DateTime?
  approvedBy     User?        @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  initiatedBy    User         @relation("RefundInitiatedBy", fields: [initiatedById], references: [id])
  order          Order        @relation(fields: [orderId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  payment        Payment      @relation(fields: [paymentId], references: [id])
  items          RefundItem[]

  @@index([orderId])
  @@index([paymentId])
  @@index([branchId, status])
}

model RefundItem {
  id             String    @id @default(uuid())
  refundId       String
  orderItemId    String
  quantity       Decimal   @db.Decimal(12, 3)
  refundedAmount Decimal   @db.Decimal(18, 2)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id])
  refund         Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([orderItemId])
}

model VoidRecord {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  orderId        String
  reason         String
  voidedById     String
  createdAt      DateTime     @default(now())
  branch         Branch       @relation(fields: [branchId], references: [id])
  order          Order        @relation(fields: [orderId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  voidedBy       User         @relation(fields: [voidedById], references: [id])

  @@index([orderId])
  @@index([branchId, createdAt])
}

model ApprovalRequest {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  requestedById String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model CashierShift {
  id             String               @id @default(uuid())
  organizationId String
  branchId       String
  cashierId      String
  status         String               @default("OPEN")
  version        Int                  @default(1)
  openingFloat   Decimal              @db.Decimal(18, 2)
  expectedCash   Decimal              @default(0) @db.Decimal(18, 2)
  actualCash     Decimal?             @db.Decimal(18, 2)
  variance       Decimal?             @db.Decimal(18, 2)
  openedAt       DateTime             @default(now())
  closedAt       DateTime?
  counts         CashCount[]
  movements      CashMovement[]
  branch         Branch               @relation(fields: [branchId], references: [id])
  reconciliation ShiftReconciliation?
}

model CashMovement {
  id         String       @id @default(uuid())
  shiftId    String
  type       String
  amount     Decimal      @db.Decimal(18, 2)
  reason     String?
  userId     String
  sourceId   String?
  sourceType String?
  createdAt  DateTime     @default(now())
  shift      CashierShift @relation(fields: [shiftId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
}

model KitchenStation {
  id             String          @id @default(uuid())
  branchId       String
  organizationId String
  name           String
  displayOrder   Int             @default(0)
  isActive       Boolean         @default(true)
  branch         Branch          @relation(fields: [branchId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  KitchenTicket  KitchenTicket[]
  OrderItem      OrderItem[]
  printers       Printer[]
  products       Product[]
  staff          UserStation[]

  @@unique([branchId, name])
}

/// Which prep stations a person works at (a barista → Coffee). Their kitchen screen opens on these.
model UserStation {
  id        String         @id @default(uuid())
  userId    String
  stationId String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([stationId])
}

model Printer {
  id         String          @id @default(uuid())
  branchId   String
  stationId  String?
  kind       String          @default("KITCHEN") // KITCHEN | RECEIPT
  name       String
  ipAddress  String?
  port       Int             @default(9100)
  macAddress String?
  isActive   Boolean         @default(true)
  status     String          @default("UNKNOWN") // UNKNOWN | ONLINE | OFFLINE
  lastSeenAt DateTime?
  lastError  String?
  branch     Branch          @relation(fields: [branchId], references: [id])
  station    KitchenStation? @relation(fields: [stationId], references: [id])
  jobs       PrinterJob[]
}

/// The small program running inside the cafe that talks to the printers.
model PrintAgent {
  id         String    @id @default(uuid())
  branchId   String
  name       String
  keyHash    String    @unique
  lastSeenAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchId], references: [id])
}

model PrinterJob {
  id           String         @id @default(uuid())
  printerId    String
  ticketId     String?
  ticketType   String
  payload      Json
  status       String         @default("PENDING")
  createdAt    DateTime       @default(now())
  attemptCount Int            @default(0)
  errorMessage String?
  isReprint    Boolean        @default(false)
  printedAt    DateTime?
  claimedAt    DateTime?
  printer      Printer        @relation(fields: [printerId], references: [id])
  ticket       KitchenTicket? @relation(fields: [ticketId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id])
}

model SecurityEvent {
  id                String   @id @default(uuid())
  organizationId    String?
  actorUserId       String?
  usernameAttempted String?
  ipAddress         String?
  userAgent         String?
  eventType         String
  reason            String?
  requestId         String?
  createdAt         DateTime @default(now())
}

model OrderItemModifier {
  id                 String       @id @default(uuid())
  organizationId     String
  branchId           String
  orderItemId        String
  modifierId         String?
  nameSnapshot       String
  priceDeltaSnapshot Decimal      @db.Decimal(18, 2)
  version            Int          @default(1)
  branch             Branch       @relation(fields: [branchId], references: [id])
  orderItem          OrderItem    @relation(fields: [orderItemId], references: [id])
  organization       Organization @relation(fields: [organizationId], references: [id])
}

model KitchenTicket {
  id              String         @id @default(uuid())
  organizationId  String
  branchId        String
  orderId         String
  stationId       String
  fireBatchNumber Int
  ticketType      String
  status          String         @default("PENDING")
  version         Int            @default(1)
  firedAt         DateTime       @default(now())
  branch          Branch         @relation(fields: [branchId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id])
  organization    Organization   @relation(fields: [organizationId], references: [id])
  station         KitchenStation @relation(fields: [stationId], references: [id])
  items           OrderItem[]
  printerJobs     PrinterJob[]

  @@unique([orderId, stationId, fireBatchNumber])
}

model BranchConfiguration {
  id                String  @id @default(uuid())
  branchId          String  @unique
  currency          String  @db.Char(3)
  taxRate           Decimal @default(15.00) @db.Decimal(5, 2)
  isTaxInclusive    Boolean @default(false)
  serviceChargeRate Decimal @default(10.00) @db.Decimal(5, 2)
  roundingMode      String  @default("HALF_UP")
  version           Int     @default(1)
  varianceTolerance Decimal @default(0.00) @db.Decimal(18, 2)
  largeDiscountPercent Decimal @default(10.00) @db.Decimal(5, 2)
  cashierRefundLimit   Decimal @default(500.00) @db.Decimal(18, 2)
  ticketWarnMinutes    Int     @default(8)
  ticketLateMinutes    Int     @default(12)
  tinNumber            String?
  receiptFooter        String?
  verifyBySecondPerson Boolean @default(false) // true: the cashier who took a digital payment can't verify it
  waiterPayments       Boolean @default(true)  // waiters may record transfer payments (with a photo) from their phone
  waiterPhotoRequired  Boolean @default(true)  // ...and must attach the customer's confirmation screenshot
  branch            Branch  @relation(fields: [branchId], references: [id])
}

model OrderItemStatusHistory {
  id          String    @id @default(uuid())
  orderItemId String
  fromStatus  String
  toStatus    String
  changedById String
  createdAt   DateTime  @default(now())
  changedBy   User      @relation(fields: [changedById], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

model PaymentEvidence {
  id         String    @id @default(uuid())
  fileUrl    String
  uploadedAt DateTime  @default(now())
  payments   Payment[]
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  organizationId String
  endpoint       String
  idempotencyKey String
  responseCode   Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, endpoint, idempotencyKey])
}

model CashCount {
  id           String       @id @default(uuid())
  shiftId      String
  denomination Decimal      @db.Decimal(18, 2)
  count        Int
  amount       Decimal      @db.Decimal(18, 2)
  createdAt    DateTime     @default(now())
  shift        CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

model ShiftReconciliation {
  id              String       @id @default(uuid())
  shiftId         String       @unique
  expectedCash    Decimal      @db.Decimal(18, 2)
  actualCash      Decimal      @db.Decimal(18, 2)
  variance        Decimal      @db.Decimal(18, 2)
  openingFloat    Decimal      @db.Decimal(18, 2)
  cashSales       Decimal      @default(0) @db.Decimal(18, 2)
  cashRefunds     Decimal      @default(0) @db.Decimal(18, 2)
  cashDeposits    Decimal      @default(0) @db.Decimal(18, 2)
  cashWithdrawals Decimal      @default(0) @db.Decimal(18, 2)
  status          String       @default("PENDING")
  approvedById    String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approvedBy      User?        @relation("ShiftReconciliationApprovedBy", fields: [approvedById], references: [id])
  shift           CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model Receipt {
  id              String    @id @default(uuid())
  organizationId  String
  branchId        String
  orderId         String
  paymentId       String
  receiptNumber   String
  content         Json
  reprintCount    Int       @default(0)
  lastReprintedBy String?
  lastReprintedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([branchId, receiptNumber])
  @@index([orderId])
}


model SyncEvent {
  id               String   @id @default(uuid())
  organizationId   String
  branchId         String
  deviceId         String
  localEventId     String
  entityType       String   // "Order" for V1
  entityId         String   // client-side temp id
  eventType        String   // "ORDER_SUBMITTED"
  payload          Json
  clientTimestamp  DateTime
  serverReceivedAt DateTime @default(now())
  syncStatus       String   // PENDING | SYNCED | REJECTED | CONFLICT
  retryCount       Int      @default(0)
  errorMessage     String?
  serverEntityId   String?  // populated after successful sync

  @@unique([deviceId, localEventId])
  @@index([organizationId, syncStatus])
}


/// Per-branch, per-day counters (order numbers, receipt numbers).
/// Incremented with UPDATE ... RETURNING inside the transaction, so numbers never collide.
model BranchCounter {
  branchId  String
  scope     String // e.g. "ORDER:20260925"
  lastValue Int    @default(0)

  @@id([branchId, scope])
}

/// A manager's one-time approval, created by entering their PIN on someone else's device.
model ApprovalGrant {
  id             String    @id @default(uuid())
  organizationId String
  tokenHash      String    @unique
  approverId     String
  requestedById  String
  permission     String
  expiresAt      DateTime
  usedAt         DateTime?
  usedFor        String?
  createdAt      DateTime  @default(now())
  approver       User      @relation("ApprovalGrantApprover", fields: [approverId], references: [id])

  @@index([organizationId, createdAt])
}

/// How customers can pay at a branch. Managed in Settings → Payment methods.
model PaymentMethod {
  id                   String   @id @default(uuid())
  branchId             String
  code                 String   // stored on Payment.method, e.g. "TELEBIRR"
  name                 String   // shown to staff and on receipts
  kind                 String   // CASH | CARD | MOBILE_MONEY | BANK_APP | OTHER
  requiresReference    Boolean  @default(true)
  requiresProof        Boolean  @default(false) // screenshot of the customer's confirmation
  requiresVerification Boolean  @default(true)  // a second person checks the statement before it counts
  askPayerBank         Boolean  @default(false) // "Other bank": cashier types which bank
  accountInfo          String?  // your merchant number / account, printed on bills
  isActive             Boolean  @default(true)
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  branch               Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, code])
}
