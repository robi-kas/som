# systemd unit — keeps the agent running and restarts it after power cuts.
#   sudo cp print-agent.service /etc/systemd/system/
#   sudo systemctl enable --now print-agent
[Unit]
Description=New Chapter POS print agent
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/print-agent
ExecStart=/usr/bin/node /opt/print-agent/agent.mjs
Restart=always
RestartSec=3
User=pi

[Install]
WantedBy=multi-user.target
